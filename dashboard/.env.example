# Comma-separated, case-insensitive allowlist for authenticated household users.
WELLNESS_ALLOWED_EMAILS=owner@example.com,member@example.com

# Local worker identity. It activates only when this explicit flag is true and
# the request host is localhost or 127.0.0.1. Never configure these keys in Sites.
WELLNESS_ENABLE_LOCAL_AUTH=true
WELLNESS_DEV_USER_ID=local-owner
WELLNESS_DEV_USER_EMAIL=local@example.test
WELLNESS_DEV_USER_NAME=Local household owner
