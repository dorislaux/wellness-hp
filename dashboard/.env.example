# Comma-separated, case-insensitive allowlist for authenticated household users.
WELLNESS_ALLOWED_EMAILS=owner@example.com,member@example.com

# Local worker identity. It activates only when this explicit flag is true and
# the request host is localhost or 127.0.0.1. Never configure these keys in Sites.
WELLNESS_ENABLE_LOCAL_AUTH=true
WELLNESS_DEV_USER_ID=local-owner
WELLNESS_DEV_USER_EMAIL=local@example.test
WELLNESS_DEV_USER_NAME=Local household owner

# The dashboard stays fully fictional unless this is explicitly changed.
WELLNESS_DATA_MODE=mock

# Live Sites mode will be enabled after the D1 reader and provider routes exist.
# WELLNESS_DATA_MODE=sites

# Hosted secrets. Values must be unpadded base64url containing exactly 32 bytes.
# TOKEN_ENCRYPTION_KEY_V1=<configure-in-sites-secret-manager>
# PROVIDER_SUBJECT_HASH_KEY_V1=<configure-in-sites-secret-manager>
# OAUTH_STATE_HASH_KEY_V1=<configure-in-sites-secret-manager>

# Non-secret household setting used to assign provider records to a local day.
WELLNESS_TIMEZONE=Asia/Shanghai

# WHOOP hosted OAuth settings. Configure the secret value only in Sites.
# WHOOP_CLIENT_ID=<hosted-environment-value>
# WHOOP_CLIENT_SECRET=<configure-in-sites-secret-manager>
# WHOOP_REDIRECT_URI=https://your-site.example/oauth/whoop/callback

# Oura hosted OAuth settings. Configure the secret value only in Sites.
# OURA_CLIENT_ID=<hosted-environment-value>
# OURA_CLIENT_SECRET=<configure-in-sites-secret-manager>
# OURA_REDIRECT_URI=https://your-site.example/oauth/oura/callback
